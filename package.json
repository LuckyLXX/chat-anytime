{
  "name": "chat-anytime",
  "version": "0.1.0",
  "private": true,
  "description": "ChatAnyTime desktop client powered by the Pi coding agent SDK",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win dir",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "highlight.js": "11.11.1",
    "html2canvas-pro": "^2.3.3",
    "katex": "0.16.22",
    "lucide-react": "0.468.0",
    "mermaid": "11.16.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "strip-json-comments": "5.0.3",
    "typebox": "1.1.38",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vditor": "^3.11.3",
    "vite": "7.3.6",
    "vitest": "4.0.18"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1"
  },
  "build": {
    "appId": "dev.chatanytime.desktop",
    "productName": "ChatAnyTime",
    "directories": {
      "output": "dist"
    },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/@modelcontextprotocol/**",
    "**/node_modules/typebox/**"
  ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
